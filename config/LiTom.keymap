#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <3>;
    temp-layer-activation-delay-ms = <0>;
    temp-layer-deactivation-delay-ms = <5000>;
};

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        tab_slide: behavior_sensor_rotate_tab_slide {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_TAB_SLIDE";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp LA(LG(RIGHT_ARROW))>;
            ccw-binding = <&kp LA(LG(LEFT_ARROW))>;
            tap-ms = <20>;
        };
    };

    keymap: combos {
        compatible = "zmk,combos";

        eisu_base {
            bindings = <&kp LANG2>;
            key-positions = <18 17>;
            require-prior-idle-ms = <0>;
            layers = <0>;
        };

        kana_base {
            bindings = <&kp LANG1>;
            key-positions = <21 22>;
            layers = <0>;
        };

        paren_pair {
            bindings = <&paren_left_cursor>;
            key-positions = <24 25>;
            layers = <0>;
        };
    };

    macros {
        paren_left_cursor: paren_left_cursor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "PAREN_LEFT_CURSOR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &lt 4 MINUS
&kp TAB    &kp Q        &kp W     &kp E  &kp R         &kp T      &kp Y      &kp U            &kp I              &kp O            &kp P     &kp LEFT_BRACKET
&kp CAPS   &kp A        &kp S     &kp D  &kp F         &kp G      &kp H      &kp J            &kp K              &kp L            &kp SEMI  &kp APOS
&kp LSHFT  &kp Z        &kp X     &kp C  &kp V         &kp B      &kp N      &kp M            &kp COMMA          &kp DOT          &kp FSLH  &kp INT1
&kp LCTRL  &kp LGUI     &kp LALT  &mo 3  &lt 1 DELETE  &kp SPACE  &kp ENTER  &lt 2 BACKSPACE  &kp RIGHT_BRACKET  &kp NON_US_HASH
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        NUM {
            bindings = <
&trans  &trans
&trans  &kp N1            &kp N2          &kp N3          &kp N4           &kp N5     &kp N6         &kp N7  &kp N8      &kp N9  &kp N0        &kp LEFT_BRACKET
&trans  &trans            &trans          &kp UP_ARROW    &kp INT3         &kp COMMA  &kp LS(MINUS)  &kp N4  &kp N5      &kp N6  &kp KP_MINUS  &kp KP_SLASH
&trans  &kp LEFT_BRACKET  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp COLON  &kp NUMBER_0   &kp N1  &kp N2      &kp N3  &kp KP_PLUS   &kp KP_ASTERISK
&trans  &trans            &trans          &trans          &trans           &trans     &trans         &trans  &kp PERIOD  &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        FUNCTION {
            bindings = <
&trans  &trans
&trans  &trans  &trans                  &kp LG(Z)           &trans                   &trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &trans
&trans  &trans  &kp LS(LG(LEFT_ARROW))  &kp LG(UP_ARROW)    &kp LS(LG(RIGHT_ARROW))  &trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans
&trans  &trans  &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans
&trans  &trans  &trans                  &trans              &trans                   &trans  &trans   &trans   &trans  &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo 0   &trans    &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        BT {
            bindings = <
&trans          &trans
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &bt BT_PRV    &bt BT_NXT    &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&studio_unlock  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        ARROW {
            bindings = <
&trans     &trans
&kp GRAVE  &kp LC(LS(TAB))         &kp LG(RIGHT)  &kp NUMBER_9             &kp NUMBER_0       &oled_mode  &oled_mode  &trans  &kp RC(LEFT_ARROW)  &kp UP_ARROW      &kp RC(RIGHT_ARROW)  &kp LG(P)
&kp TAB    &kp LA(LG(LEFT_ARROW))  &kp LG(LEFT)   &kp LG(LA(RIGHT_ARROW))  &kp LEFT_BRACKET   &trans      &trans      &trans  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &kp LG(K)
&kp LCMD   &kp LG(LS(LEFT_ARROW))  &trans         &kp LG(LS(RIGHT_ARROW))  &kp RIGHT_BRACKET  &trans      &trans      &trans  &trans              &kp LC(UP_ARROW)  &trans               &kp LG(L)
&trans     &trans                  &trans         &trans                   &trans             &trans      &trans      &trans  &trans              &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };
    };
};
